# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local. NEVER paste these into the browser.
# ============================================================

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public copies for the browser (safe — anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (platform.openai.com -> API keys) — used for AI-generated site photography ---
OPENAI_API_KEY=sk-...

# --- Stripe (Developers -> API keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs (Product catalogue -> your product -> price -> copy ID, starts price_)
STRIPE_PRICE_STANDARD_MONTHLY=price_...
STRIPE_PRICE_STANDARD_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_FRONTIER_MONTHLY=price_...
STRIPE_PRICE_FRONTIER_ANNUAL=price_...

# Top-up packs (one-off prices) — leave blank until you launch top-ups
STRIPE_PRICE_TOPUP_25=
STRIPE_PRICE_TOPUP_60=
STRIPE_PRICE_TOPUP_150=

# --- Your app ---
APP_URL=http://localhost:3000

# --- Publishing customer sites ---
# Optional. A domain with a wildcard DNS record (*.lumen.build) pointed at this
# app, so customer sites get addresses like theirsite.lumen.build.
# Leave blank and sites are served at /s/theirsite instead — which works today.
SITES_DOMAIN=

# Optional. Lets Lumen register customers' custom domains automatically so
# HTTPS certificates are issued. Without these, domains are saved and the
# customer is shown the DNS records, but you add the domain in Vercel manually.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Scheduled jobs (vercel.json -> crons) ---
# Any long random string. Vercel sends it as `Authorization: Bearer <this>`
# on every cron request; the routes reject anything else, so an unset value
# means the nightly purge and the nightly backup both silently 401.
CRON_SECRET=

# Required for site analytics. Any long random string. It keys the
# visitor hash (ip + user-agent + day), which is the only thing standing
# between the events table and a re-identifiable IP — so treat it like a
# secret, and note that rotating it orphans every existing hash.
ANALYTICS_SALT=
