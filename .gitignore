.DS_Store
scripts/_investigate-*.mjs

# Licensed Animmaster component pack: a local reference only. Its code is
# adapted into public/ by hand; the pack itself must never be committed.
vendor/animmaster/

# Raw video masters. They exist only to produce the two files below,
# and git history is permanent -- a superseded 24 MB master would be
# in every clone forever. Ignore everything here except what ships.
public/video/*
!public/video/lintel-ad.mp4
!public/video/lintel-ad-poster.jpg
!public/video/lintel-ad-poster-*.webp

# Studio source masters, same reasoning: only the compressed files ship.
public/img/studio/*
!public/img/studio/*.webp
!public/img/studio/*.jpg
!public/img/studio/studio-hero-web.mp4
