node_modules
.next
.env.local
.env
.DS_Store
scripts/_investigate-*.mjs

# Licensed Animmaster component pack: a local reference only. Its code is
# adapted into public/ by hand; the pack itself must never be committed.
vendor/animmaster/

# Raw video masters. They exist only to produce the two files below,
# and git history is permanent -- a superseded 24 MB master would be
# in every clone forever. Ignore everything here except what ships.
public/video/*
!public/video/lintel-ad.mp4
!public/video/lintel-ad-poster.jpg
!public/video/lintel-ad-poster-*.webp

# Studio source masters, same reasoning: only the compressed files ship.
public/img/studio/*
!public/img/studio/*.webp
!public/img/studio/*.jpg
!public/img/studio/studio-hero-web.mp4

# Claude Code. The skills in .claude/skills/ are shared and committed; these two
# are not. Worktrees are throwaway checkouts of this same repo, created per task
# and deleted after -- committing them would nest the repo inside itself.
# settings.local.json holds per-machine tool permissions.
.claude/worktrees/
.claude/settings.local.json

# Audit reports are committed; the evidence behind them is not. A run leaves
# ~84 MB of Lighthouse JSON, axe output and screenshots under audits/raw/,
# and git history is permanent. The report cites paths into it -- regenerate
# with the lintel-audit skill if you need to see the raw numbers again.
audits/raw/
